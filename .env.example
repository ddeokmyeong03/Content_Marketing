# Anthropic API
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Meta Graph API
META_ACCESS_TOKEN=your_meta_long_lived_token_here
META_IG_USER_ID=your_instagram_user_id_here
META_THREADS_USER_ID=your_threads_user_id_here
# 토큰 자동 갱신용 (Meta 앱 자격증명 — Instagram 토큰 갱신 시 필요)
META_APP_ID=
META_APP_SECRET=

# App settings
DATA_DIR=./data
BRAND_CONFIG_PATH=./brand/config.yaml
LOG_LEVEL=INFO

# AI (선택)
ANTHROPIC_MODEL=claude-opus-4-8

# Graph API / 스케줄러 (선택 — 기본값 사용 가능)
META_GRAPH_VERSION=v21.0
THREADS_PUBLISH_DELAY_SECONDS=5
PUBLISH_POLL_MINUTES=5
WEEKLY_PLAN_CRON_DAY=sun
WEEKLY_PLAN_CRON_HOUR=18
TOKEN_REFRESH_HOUR=3
SCHEDULER_TIMEZONE=Asia/Seoul
TOKEN_REFRESH_THRESHOLD_DAYS=7

# 알림 (선택 — 비우면 콘솔 로그만)
NOTIFY_WEBHOOK_URL=

# 참여·응대 (계정 활성화)
COMMENT_POLL_MINUTES=15
AUTO_REPLY=false
GOLDEN_HOUR_MINUTES=60

# 발행 재시도 (선택 — 일시 장애로 예약 게시물이 죽지 않게)
PUBLISH_MAX_ATTEMPTS=4
PUBLISH_RETRY_BACKOFF_MINUTES=5
PUBLISH_RETRY_MAX_MINUTES=360

# 캐러셀 카드 렌더링 (선택)
#   playwright가 브라우저를 직접 설치할 수 없는 환경에서 실행 파일을 지정
BRANDING_CHROMIUM_PATH=
